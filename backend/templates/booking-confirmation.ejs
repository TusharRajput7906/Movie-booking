<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Booking Confirmed</title>
</head>
<body style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background-color: #f6f6f6; margin: 0; padding: 20px;">
  <div style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05); border: 1px solid #e9e9e9;">
    <!-- Green Header -->
    <div style="background-color: #2ec4b6; padding: 30px; text-align: center; color: #ffffff;">
      <h1 style="margin: 0; font-size: 24px; font-weight: 600;">Booking Confirmed!</h1>
    </div>
    
    <div style="padding: 30px; color: #333333;">
      <p style="font-size: 16px; line-height: 1.5; margin-top: 0;">Hello <strong><%= name %></strong>,</p>
      <p style="font-size: 14px; line-height: 1.5; color: #666666;">Your booking has been successfully confirmed. Below are your booking details:</p>
      
      <!-- Details Table -->
      <table style="width: 100%; border-collapse: collapse; margin-top: 20px; margin-bottom: 20px;">
        <tr style="border-bottom: 1px solid #eeeeee;">
          <td style="padding: 10px 0; font-weight: 500; color: #666666; font-size: 14px; width: 35%;">Booking ID</td>
          <td style="padding: 10px 0; font-size: 14px; color: #333333;"><%= bookingId %></td>
        </tr>
        <tr style="border-bottom: 1px solid #eeeeee;">
          <td style="padding: 10px 0; font-weight: 500; color: #666666; font-size: 14px;">Movie</td>
          <td style="padding: 10px 0; font-size: 14px; color: #333333; font-weight: bold;"><%= movieTitle %></td>
        </tr>
        <tr style="border-bottom: 1px solid #eeeeee;">
          <td style="padding: 10px 0; font-weight: 500; color: #666666; font-size: 14px;">Theater</td>
          <td style="padding: 10px 0; font-size: 14px; color: #333333;"><%= theaterName %></td>
        </tr>
        <tr style="border-bottom: 1px solid #eeeeee;">
          <td style="padding: 10px 0; font-weight: 500; color: #666666; font-size: 14px;">Show Time</td>
          <td style="padding: 10px 0; font-size: 14px; color: #333333;"><%= showTime %></td>
        </tr>
        <tr style="border-bottom: 1px solid #eeeeee;">
          <td style="padding: 10px 0; font-weight: 500; color: #666666; font-size: 14px;">Seats</td>
          <td style="padding: 10px 0; font-size: 14px; color: #333333; font-weight: bold; color: #2ec4b6;"><%= seatNumbers %></td>
        </tr>
        <tr style="border-bottom: 1px solid #eeeeee;">
          <td style="padding: 10px 0; font-weight: 500; color: #666666; font-size: 14px;">Amount Paid</td>
          <td style="padding: 10px 0; font-size: 14px; color: #333333; font-weight: bold;">INR <%= amount %></td>
        </tr>
        <tr style="border-bottom: 1px solid #eeeeee;">
          <td style="padding: 10px 0; font-weight: 500; color: #666666; font-size: 14px;">Payment ID</td>
          <td style="padding: 10px 0; font-size: 14px; color: #888888; font-family: monospace;"><%= paymentId %></td>
        </tr>
      </table>
      
      <p style="font-size: 14px; line-height: 1.5; color: #666666; margin-bottom: 0;">Please show this confirmation email at the theater entrance to collect your physical tickets.</p>
    </div>
    
    <!-- Footer -->
    <div style="background-color: #fafafa; padding: 20px; text-align: center; border-top: 1px solid #eeeeee; color: #999999; font-size: 12px;">
      <p style="margin: 0 0 5px 0;">Thank you for booking with MovieBooking</p>
      <p style="margin: 0;">&copy; 2026 MovieBooking. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
